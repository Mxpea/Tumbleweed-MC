{
  "name": "tumbleweed-mc",
  "version": "0.1.0",
  "description": "Minecraft server-side modpack packer that produces redistributable zip without bundling mod jars.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tumbleweed": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && esbuild ./src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --sourcemap --minify",
    "dev": "tsx ./src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src",
    "format": "biome format --write ./src",
    "test": "node --test --import tsx tests/**/*.test.ts"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@inquirer/prompts": "^7.0.0",
    "commander": "^12.1.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}